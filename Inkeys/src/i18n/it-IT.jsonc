      "Eraser":
      {
        "N": "Gomma",
        "Automatic": "Attiva gomma sensibile alla velocità",
        "SpeedEraser":
        {
          "DemoFineTitle": "Cancellazione precisa",
          "DemoFineDescription": "Cancella lentamente la linea di costruzione lasciando intatti i segni e i segmenti vicini.",
          "DemoSweepTitle": "Cancella aree estese",
          "DemoSweepDescription": "Con passaggi ripetuti avanti e indietro, la gomma si allarga gradualmente per cancellare più rapidamente ampie aree.",
          "EntryDescription": "Adatta lo spessore della gomma al modo in cui vuoi cancellare",
          "Introduction": "Usa le dimensioni del dispositivo, il tipo di input e il movimento per riconoscere l'intenzione di cancellazione e regolare dinamicamente la gomma.",
          "BasicSettings": "Impostazioni di base",
          "EnabledDevices": "Dispositivi attivi",
          "FineControl": "Controllo preciso",
          "SizeWarningTitle": "Dimensioni dello schermo non affidabili",
          "SizeWarningDescription": "Lo schermo usato per disegnare non fornisce dimensioni fisiche affidabili. Touch e penne su schermo useranno una stima basata sui DPI: la gomma potrebbe non corrispondere all'intenzione di cancellazione."
        },
        "PalmEraser":
        {
          "N": "Gomma con il palmo",
          "EntryDescription": "Cancella con un contatto ampio senza cambiare strumento",
          "Introduction": "Appoggia il palmo sullo schermo per cancellare senza cambiare strumento. La dimensione viene determinata nell'intervallo di riconoscimento dopo il contatto; sollevando il palmo rimane selezionato lo strumento originale.",
          "Enabled": "Attiva gomma con il palmo",
          "SizeWarningTitle": "Dimensioni dello schermo non affidabili",
          "SizeWarningDescription": "Lo schermo non fornisce dimensioni fisiche affidabili. La gomma con il palmo resta disponibile usando una soglia di base di 100×100 DIP di sistema. La misura in centimetri può variare: regola la percentuale secondo le tue esigenze.",
          "RecognitionWindow": "Intervallo di riconoscimento",
          "RecognitionWindowDescription": "Riconosci il palmo e determinane la dimensione in questo intervallo dall'inizio del contatto. La cancellazione inizia appena sono soddisfatte le condizioni.",
          "Threshold": "Soglia dell'area di contatto",
          "ThresholdDescription": "Aumenta la percentuale per ridurre le attivazioni involontarie, oppure riducila per riconoscere più facilmente il palmo.",
          "ThresholdSizePhysical": "Soglia attuale: {:.2f}cm × {:.2f}cm ({:.0f}px × {:.0f}px)",
          "ThresholdSizePixels": "Soglia attuale: {:.0f}px × {:.0f}px",
          "PreviewTitle": "Esempi dell'area di contatto (schermo di disegno)",
          "PreviewDescription": "L'area delimitata mostra la soglia in pixel dello schermo di disegno corrente. Cambia proporzioni per confrontare le forme. Su un altro schermo le dimensioni in centimetri potrebbero essere diverse.",
          "PreviewEstimated": "Questa soglia stimata in pixel usa l'area di base di 100×100 DIP di sistema e la percentuale corrente. Cambia proporzioni per confrontare le forme; le dimensioni in centimetri potrebbero variare.",
          "PreviewUnavailable": "La scala dello schermo di disegno non è ancora disponibile: impossibile mostrare gli esempi dell'area.",
          "EnabledTools": "Strumenti interessati",
