      "SuperTop":
      {
        "N": "SuperTop",
        "E": "Use UIAccess to display the window above supported system UI and application windows.",
        "Warn": "The SuperTop plugin is in Beta and may be unstable.\nAt startup, Inkeys restarts itself to request elevated privileges, then launches a new instance.\nThis process may fail; running with administrator privileges can affect PPT integration.\nElevation may trigger a UAC prompt. Verify the source and publisher before allowing it.\nIf security software raises an alert, check the file source and signature instead of disabling protection.",
        "Capability":
        {
          "N": "Basic Capabilities",
          "SuperTop": "Enable SuperTop",
          "SuperTopE1": "The application uses a three-stage launch to keep its windows on top.\n(SuperTop is currently active)",
          "SuperTopE2": "The application uses a three-stage launch to keep its windows on top.\n(SuperTop is not active)",
          "Indicator": "SuperTop Indicator",
          "IndicatorE": "Displays a pin icon on the top-right corner of the main application icon when successfully enabled.",
          "SuperTopNote": "Restart Inkeys to apply. The topmost launch may fail."
        },
        "SupportNote": "Requires Windows 8 or newer."
      },
      "DesktopDrawpadBlocker":
      {
        "N": "DesktopDrawpadBlocker 3 Lite",
        "E": "On all-in-one educational machines, some whiteboard software's floating window toolbar cannot be turned off directly, leading to multiple drawing tools appearing on the desktop. This often causes teachers to mix up different tools, making it impossible to continue annotations and severely impacting teaching efficiency. Thus, DesktopDrawpadBlocker was created.",
        "LicenseTitle": "GPLv3 open-source plugin",
        "LicenseDescription": "This plugin is for learning, discussion, and research only; it must not be used for any other purpose.\nDesktopDrawpadBlocker is open-source software released under the GPLv3 licence.\nPublished on GitHub: https://github.com/Alan-CRL/DesktopDrawpadBlocker\nWe hope this program is useful, but provide no warranty of quality.\nUsers are responsible for the effects and consequences of using this plugin; use constitutes acceptance of this agreement.",
        "UseSection": "Using the plugin",
        "EnableTitle": "Enable plugin",
        "EnableDescription": "In the default mode, the plugin starts and stops with Inkeys.",
        "GeneralSection": "General options",
        "AdministratorTitle": "Run the plugin as administrator",
        "AdministratorDescription": "Wait for the plugin to respond when changing this setting.",
        "IntervalTitle": "Blocking interval",
