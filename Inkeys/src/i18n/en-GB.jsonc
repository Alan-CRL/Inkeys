        "PrecisionSection": "Detailed control",
        "Seewo3Title": "希沃白板3 — desktop pen window",
        "Seewo5Title": "希沃白板5 — desktop pen window",
        "Seewo5CTitle": "希沃轻白板（5C） — desktop pen window",
