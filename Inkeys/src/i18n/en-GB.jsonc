        "SeewoPptTitle": "希沃PPT小工具",
        "IwbAssistantTitle": "希沃课堂助手 — PPT tools",
        "YiouTitle": "欧帝白板 — desktop pen window",
        "AiClassTitle": "AiClass — desktop pen window",
        "ClassInXTitle": "ClassIn X — desktop pen window",
