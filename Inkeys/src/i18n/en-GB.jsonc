        "EntryDescription": "Choose the drawing cursor for each input device and preview it.",
        "Devices": "By device",
        "PenDevices": "Pen tablet detection",
        "Mouse":
        {
          "N": "Mouse",
          "E": "Mouse and touchpad."
        },
        "Touch":
        {
          "N": "Touch",
          "E": "Each finger that is drawing shows its own cursor, which disappears when lifted."
        },
        "ScreenPen":
        {
          "N": "Screen pen",
          "E": "A pen that writes directly on the screen."
        },
        "Tablet":
        {
          "N": "Pen tablet",
          "E": "External pen tablets and pens whose source cannot be recognized."
        },
        "Style":
        {
          "None": "No cursor",
          "Arrow": "Mouse",
          "Pen": "Pen",
          "HighlightPen": "Pen (highlighted)",
          "Dot": "Small dot",
          "HighlightDot": "Small dot (highlighted)"
        },
        "InjectedMouse":
        {
          "N": "Recognize driver-injected tablets",
          "E": "Pen tablets without Windows Ink usually arrive as a mouse injected by the driver. When on, that mouse uses the pen tablet cursor settings; software that also injects a mouse, such as remote desktop, may be misdetected.",
          "Unavailable": "This system cannot tell input sources apart, so this option is unavailable."
        },
        "FineControl": "Fine controls",
        "DotHideOnContact":
        {
          "N": "Automatically hide the small dot cursor on contact",
          "E": "Applies to both small dot styles. The cursor hides when the selected device touches down and remains visible while hovering.",
          "Off": "Off",
          "ScreenPen": "Screen pen only",
          "Tablet": "Pen tablet only",
          "Both": "Screen pen and pen tablet"
        },
        "Note": "On screen pens, pen tablets and touch, \"Mouse\" is an arrow drawn by the app itself; the highlighter, laser pointer, shape tools and eraser keep their own cursors regardless of these options."
      },
      "Effect":
      {
        "N": "Drawing environment",
        "Device":
        {
          "N": "Choose an interaction mode",
          "Touch": "Large-Screen Touch Mode",
          "MousePen": "Desktop Mode",
          "TouchE": "For writing and interacting directly on large touchscreens in classrooms, meeting rooms, and similar settings.",
          "MousePenE": "For PCs, tablets, and mouse-operated large displays, with mouse, pen, graphics tablet, or touch input."
        }
      },
      "Touch":
      {
        "N": "Touch",
        "InterruptedStrokeReconnect":
        {
          "N": "Reconnect interrupted strokes",
          "E": "When touch briefly drops out and resumes in the same direction, the app tries to join both parts into one stroke, reducing gaps. When disabled, lifting your finger ends the stroke."
        }
      },
      "Eraser":
      {
        "N": "Eraser",
        "Automatic": "Enable speed-sensitive eraser",
        "SpeedEraser":
        {
          "DemoFineTitle": "Precise erasing",
          "DemoFineDescription": "Slowly erase the construction line while keeping nearby labels and edges intact.",
          "DemoSweepTitle": "Clear larger areas",
          "DemoSweepDescription": "Repeated strokes gradually widen the eraser to clear large areas faster.",
          "EntryDescription": "Intelligently adjust eraser size to match your drawing intent",
          "Introduction": "Uses device dimensions, input devices, and movement to infer your erasing intent and adjust the eraser size dynamically.",
          "BasicSettings": "Basic settings",
          "EnabledDevices": "Enabled devices",
          "FineControl": "Fine control",
          "SizeWarningTitle": "Reliable screen dimensions are unavailable",
          "SizeWarningDescription": "The current drawing screen lacks reliable physical dimensions. Touch and screen pens will use DPI estimates, so eraser size may not match your erasing intent."
        },
        "PalmEraser":
        {
          "N": "Palm eraser",
          "EntryDescription": "Erase with a broad touch without switching tools",
          "Introduction": "Place your palm on the screen to erase without switching tools. The eraser size is determined during the recognition window after contact; lifting your palm keeps your original tool selected.",
          "Enabled": "Enable palm eraser",
          "SizeWarningTitle": "Reliable screen dimensions unavailable",
          "SizeWarningDescription": "The current drawing screen has no reliable physical dimensions. Palm erasing is still available, using a base area threshold of 100×100 system DIPs. Its physical size may vary; adjust the percentage to suit your screen.",
          "RecognitionWindow": "Recognition window",
          "RecognitionWindowDescription": "Recognize your palm and determine its size within this time after touch begins. Erasing starts as soon as the conditions are met.",
          "Threshold": "Touch area threshold",
          "ThresholdDescription": "Increase the percentage to reduce accidental activation, or decrease it for easier palm recognition.",
          "ThresholdSizePhysical": "Current threshold: {:.2f}cm × {:.2f}cm ({:.0f}px × {:.0f}px)",
          "ThresholdSizePixels": "Current threshold: {:.0f}px × {:.0f}px",
          "PreviewTitle": "Touch area examples (current drawing screen)",
          "PreviewDescription": "The outlined area shows the current drawing screen’s pixel threshold. Switch the preview ratio to view different proportions. Its physical size may differ on another screen.",
          "PreviewEstimated": "This estimated pixel threshold uses a base area of 100×100 system DIPs and the current percentage. Select a ratio to change its shape; its physical size may vary.",
          "PreviewUnavailable": "The current drawing screen's scale is unavailable, so area examples cannot be shown yet.",
          "EnabledTools": "Applicable tools",
          "ParallelWritingMultiTouchNote": "Multi-touch drawing is off, so writing while erasing cannot take effect.",
          "ParallelWritingLaserMultiTouchNote": "Multi-touch laser input is off, so writing while erasing cannot take effect with the laser pen.",
          "ParallelWriting": "Enable writing while erasing",
          "ParallelWritingDescription": "Activating the palm eraser leaves other input uninterrupted, so drawing can continue. (For two or more people writing together.)"
        },
        "Input":
